# Copy this file outside the repository or into a private runtime directory.
# Do not commit real credentials.

# Optional hosted history read-through.
SUPERMEMORY_API_KEY=

# Optional Voyage semantic search and rerank.
VOYAGE_API_KEY=
VOYAGE_API_KEYS=
VOYAGE_API_KEY_FILE=
VOYAGE_API_KEYS_FILE=

# Optional query expansion provider.
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
NVIDIA_API_KEY_FILE=
NVIDIA_API_KEYS_FILE=
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_FILE=
GEMINI_API_KEYS_FILE=
AI_STUDIO_API_KEY_FILE=
AI_STUDIO_API_KEYS_FILE=
OPENROUTER_API_KEY=
GEMINI_EMBED_BATCH_SIZE=100
GEMINI_EMBED_BATCH_TOKENS=60000

# Optional local Apple Silicon provider services.
SELFMEM_LOCAL_EMBED_BASE_URL=http://127.0.0.1:8080/v1
SELFMEM_LOCAL_RERANK_BASE_URL=http://127.0.0.1:8081/v1
SELFMEM_QUERY_EXPANSION_BASE_URL=http://127.0.0.1:8082/v1
SELFMEM_QUERY_EXPANSION_API_KEY=local
SELFMEM_QUERY_EXPANSION_MODEL=

# Runtime tuning.
SELFMEM_RECALL_EVERY_TURN=0
SELFMEM_RERANK_CANDIDATE_LIMIT=20
SELFMEM_RERANK_TOKEN_BUDGET=6000
RECALLWEAVE_PROVIDER_DENSE_CANDIDATE_LIMIT=
