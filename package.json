{
  "name": "recallweave",
  "version": "0.1.0-alpha.0",
  "description": "Local-first native memory adapters and hybrid recall utilities for agent runtimes.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/radbroradbro/selfmem-agent-memory.git"
  },
  "bugs": {
    "url": "https://github.com/radbroradbro/selfmem-agent-memory/issues"
  },
  "homepage": "https://github.com/radbroradbro/selfmem-agent-memory#readme",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "bin": {
    "selfmem_update": "./bin/selfmem_update"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run tests",
    "typecheck": "tsc -b --pretty false",
    "privacy:test": "vitest run tests/privacy/private-redaction.test.ts",
    "smoke:openclaw": "node packages/adapters/openclaw/selfmem_canary_standalone_smoke.mjs",
    "smoke:hermes": "python3 packages/adapters/hermes/selfmem_canary_standalone_smoke.py",
    "brain:serve": "pnpm build && node packages/brain-ui/server.mjs",
    "brain:smoke": "pnpm build && node packages/brain-ui/smoke.mjs",
    "brain:smoke:built": "node packages/brain-ui/smoke.mjs",
    "brain:interaction": "pnpm build && node packages/brain-ui/interaction-smoke.mjs",
    "brain:interaction:built": "node packages/brain-ui/interaction-smoke.mjs",
    "compaction:smoke": "pnpm build && node packages/bench/session-compaction-smoke.mjs",
    "compaction:smoke:built": "node packages/bench/session-compaction-smoke.mjs",
    "compaction:benchmark": "pnpm build && node packages/bench/session-compaction-benchmark.mjs",
    "compaction:benchmark:built": "node packages/bench/session-compaction-benchmark.mjs",
    "wiki:smoke": "pnpm build && node packages/bench/wiki-vault-smoke.mjs",
    "wiki:smoke:built": "node packages/bench/wiki-vault-smoke.mjs",
    "wiki:sync:smoke": "pnpm build && node packages/bench/wiki-vault-sync-smoke.mjs",
    "wiki:sync:smoke:built": "node packages/bench/wiki-vault-sync-smoke.mjs",
    "update:smoke": "python3 packages/bench/update-flow-smoke.py",
    "release:check": "node packages/bench/release-readiness-check.mjs",
    "smoke": "pnpm privacy:test && pnpm build && pnpm typecheck && pnpm smoke:openclaw && pnpm smoke:hermes && pnpm brain:smoke:built && pnpm brain:interaction:built && pnpm compaction:smoke:built && pnpm compaction:benchmark:built && pnpm wiki:smoke:built && pnpm wiki:sync:smoke:built && pnpm update:smoke"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
