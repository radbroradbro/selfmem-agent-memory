#!/usr/bin/env sh
set -eu

SCRIPT_PATH=$0
while [ -h "$SCRIPT_PATH" ]; do
  LINK_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$LINK_DIR/$LINK_TARGET ;;
  esac
done

BIN_DIR=$(CDPATH= cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$BIN_DIR/.." && pwd)

exec python3 "$REPO_ROOT/plugins/selfmem-fallback/scripts/selfmem_update.py" "$@"
