{
  "schemaVersion": 1,
  "mode": "provider-private-env-pointer",
  "status": "PRIVATE_ENV_PRESENT",
  "publicSafe": true,
  "secretValuesIncluded": false,
  "privatePathLabel": "~/.config/recallweave/providers.private.env",
  "loadCommand": "set -a; source \"$HOME/.config/recallweave/providers.private.env\"; set +a",
  "variablesProvidedPrivately": [
    "NVIDIA_API_KEY",
    "NVCF_API_KEY",
    "NVIDIA_PROVIDER_MIN_INTERVAL_MS",
    "OPENROUTER_API_KEY",
    "OPENROUTER_PROVIDER_MIN_INTERVAL_MS",
    "OPENROUTER_PROVIDER_MAX_RETRIES",
    "OPENROUTER_PROVIDER_TIMEOUT_MS",
    "RECALLWEAVE_OPENROUTER_QUERY_EXPANSION_MODEL",
    "RECALLWEAVE_OPENROUTER_FALLBACK_QUERY_EXPANSION_MODEL",
    "RECALLWEAVE_NVIDIA_EMBED_MODEL",
    "RECALLWEAVE_PROVIDER_RETRY_ATTEMPTS",
    "RECALLWEAVE_PROVIDER_RETRY_BASE_MS",
    "RECALLWEAVE_PROVIDER_TIMEOUT_MS",
    "RECALLWEAVE_BENCHMARK_DISABLE_SUPERMEMORY_SEARCH",
    "SELFMEM_SUPERMEMORY_SEARCH_DISABLED"
  ],
  "benchmarkPolicy": {
    "nvidiaUse": "controlled hosted embed/rerank/query-expansion challenger lanes",
    "openrouterUse": "controlled hosted query-expansion and free-model challenger lanes",
    "supermemorySearchDefault": "disabled for isolated shard methodology runs",
    "hostedSupermemoryBaseline": "enable only for explicit hosted Supermemory baseline tests"
  }
}
